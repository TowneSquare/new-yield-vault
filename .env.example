# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# NOTE: fork RPC URLs are consumed via [rpc_endpoints] in foundry.toml and referenced in
# tests as vm.rpcUrl("<key>"). Never hardcode a URL or API key in a .sol file.

# ---- Fork-test RPC endpoints ----
ETH_RPC_URL=          # rpc_endpoints key: mainnet  (required by forkTest / testDeploymentETH)
MONAD_RPC_URL=        # rpc_endpoints key: monad    (required by testDeploymentMonad)
BASE_RPC_URL=         # rpc_endpoints key: base
BSC_RPC_URL=          # rpc_endpoints key: bsc

# ---- Optional fork block pins (reproducibility) ----
# Unset ETH_FORK_BLOCK defaults to 23198600. Unset MONAD_FORK_BLOCK forks at chain head,
# which is NOT reproducible — pin it once you have a known-good block.
ETH_FORK_BLOCK=
MONAD_FORK_BLOCK=

# ---- Deployment ----
DEPLOYER_PK=
ADMIN_ADDRESS=
TREASURY_ADDRESS=
EXECUTOR_ADDRESS=
REBALANCER_ADDRESS=
ASSET_ADDRESS=        # underlying asset for the target chain — verify decimals() per chain
MIN_SHARES=
MAX_REDEEM_CAP=

# ---- Block explorer verification ----
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
